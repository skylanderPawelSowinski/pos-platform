NODE_ENV=development

PORT=3000

# Local Docker Postgres (see infrastructure/docker/compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_platform"

# --- Auth ---
# DEV/TEST: HS256. Zmień sekret poza developmentem.
AUTH_JWT_SECRET=dev-secret-change-me

# PRODUKCJA (Cognito): ustaw REGION + USER_POOL_ID, aby przełączyć weryfikację
# na JWKS (RS256). Wtedy AUTH_JWT_SECRET jest ignorowany.
# COGNITO_REGION=eu-north-1
# COGNITO_USER_POOL_ID=eu-north-1_XXXXXXXXX
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
